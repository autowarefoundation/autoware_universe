<launch>
  <arg name="param_path" default="$(find-pkg-share autoware_in_lane_mrm_planner)/config/in_lane_mrm_planner.param.yaml"/>
  <arg name="eb_param_path" default="$(find-pkg-share autoware_in_lane_mrm_planner)/config/elastic_band_smoother.param.yaml"/>

  <!-- Planner inputs (override for standalone / non-bridge testing) -->
  <arg name="input_route" default="/main/planning/mission_planning/route"/>
  <arg name="input_vector_map" default="/main/map/vector_map"/>
  <arg name="input_kinematic_state" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_objects" default="/main/perception/object_recognition/objects"/>
  <arg name="input_trigger_topic" default="/planning/in_lane_mrm_planner/input/trigger"/>
  <arg name="output_trajectory" default="/planning/in_lane_mrm_planner/output/trajectory"/>
  <arg name="output_planner_status" default="/planning/in_lane_mrm_planner/debug/planner_status"/>

  <!-- Trigger relay + auxiliary gate inputs -->
  <!-- Each domain runs its own mrm_in_lane_stop_operator, so default to that domain-local topic -->
  <arg name="input_jerk_trigger" default="/control/constant_jerk_deceleration_trigger"/>
  <arg name="output_gate_gear" default="/control/control_command_gate/inputs/in_lane_stop/gear"/>
  <arg name="output_gate_hazard" default="/control/control_command_gate/inputs/in_lane_stop/hazard_lights"/>
  <arg name="output_gate_turn" default="/control/control_command_gate/inputs/in_lane_stop/turn_indicators"/>
  <arg name="auxiliary_commands_publish_hz" default="10.0"/>

  <node pkg="autoware_in_lane_mrm_planner" exec="autoware_in_lane_mrm_planner_node" name="in_lane_mrm_planner" output="screen">
    <param from="$(var param_path)"/>
    <param from="$(var eb_param_path)"/>

    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/kinematic_state" to="$(var input_kinematic_state)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/objects" to="$(var input_objects)"/>
    <remap from="~/input/trigger" to="$(var input_trigger_topic)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/debug/planner_status" to="$(var output_planner_status)"/>
  </node>

  <node pkg="autoware_in_lane_mrm_planner" exec="mrm_trigger_relay_node" name="mrm_trigger_relay" output="screen">
    <remap from="~/input/constant_jerk_deceleration_trigger" to="$(var input_jerk_trigger)"/>
    <remap from="~/output/trigger" to="$(var input_trigger_topic)"/>
  </node>

  <node pkg="autoware_in_lane_mrm_planner" exec="mrm_in_lane_stop_auxiliary_commands_node" name="mrm_in_lane_stop_auxiliary_commands" output="screen">
    <param name="publish_hz" value="$(var auxiliary_commands_publish_hz)"/>
    <remap from="~/output/gear_command" to="$(var output_gate_gear)"/>
    <remap from="~/output/hazard_lights_command" to="$(var output_gate_hazard)"/>
    <remap from="~/output/turn_indicators_command" to="$(var output_gate_turn)"/>
  </node>
</launch>
