{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Parameters for Trajectory Selector",
  "type": "object",
  "definitions": {
    "trajectory_selector": {
      "type": "object",
      "properties": {
        "generator_name_prefixes": {
          "type": "array",
          "description": "List of generator name prefixes",
          "default": [
            "DiffusionPlanner_",
            "MinimumRuleBasedPlanner_Go",
            "MinimumRuleBasedPlanner_Stop"
          ],
          "items": {
            "type": "string"
          }
        },
        "fallback_period_ms": {
          "type": "integer",
          "default": 150,
          "minimum": 1,
          "description": "fallback timer period in milliseconds",
          "validation": {
            "gt_eq<>": 100
          }
        },
        "enable_ranker": {
          "type": "boolean",
          "default": false,
          "description": "enable trajectory ranker"
        }
      },
      "required": ["fallback_period_ms"],
      "additionalProperties": false
    }
  },
  "properties": {
    "/**": {
      "type": "object",
      "properties": {
        "ros__parameters": {
          "$ref": "#/definitions/trajectory_selector"
        }
      },
      "required": ["ros__parameters"],
      "additionalProperties": false
    }
  },
  "required": ["/**"],
  "additionalProperties": false
}
