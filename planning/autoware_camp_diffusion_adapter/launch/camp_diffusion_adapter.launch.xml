<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="adapter_param_path" default="$(find-pkg-share autoware_camp_diffusion_adapter)/config/camp_diffusion_adapter.param.yaml"/>
  <arg name="vehicle_info_param_path" default="$(find-pkg-share autoware_vehicle_info_utils)/config/vehicle_info.param.yaml"/>
  <arg name="model_directory" default="$(env HOME)/autoware_data/ml_models/diffusion_planner/v5.0"/>
  <arg name="plugins_path" default="$(find-pkg-share autoware_tensorrt_plugins)/plugins/libautoware_tensorrt_plugins.so"/>
  <arg name="fixed_weight_model_path" default="$(find-pkg-share autoware_camp_selector)/config/camp_v26_k8_50k.json"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="input_odometry" default="/localization/kinematic_state"/>
  <arg name="input_acceleration" default="/localization/acceleration"/>
  <arg name="input_route" default="/planning/mission_planning/route"/>
  <arg name="input_traffic_signals" default="/perception/traffic_light_recognition/traffic_signals"/>
  <arg name="input_tracked_objects" default="/perception/object_recognition/tracking/objects"/>
  <arg name="input_vector_map" default="/map/vector_map"/>
  <arg name="input_turn_indicators" default="/vehicle/status/turn_indicators_status"/>
  <arg name="candidate_pool_topic" default="/planning/camp/candidate_pool"/>
  <arg name="selection_topic" default="/planning/camp/selection"/>
  <arg name="output_trajectories" default="/planning/camp/trajectories"/>
  <arg name="output_trajectory" default="/planning/camp/trajectory"/>
  <arg name="output_predicted_objects" default="/planning/camp/predicted_objects"/>
  <arg name="output_turn_indicators" default="/planning/camp/turn_indicators"/>
  <arg name="output_accepted_selection" default="/planning/camp/accepted_selection"/>

  <node pkg="autoware_camp_diffusion_adapter" exec="camp_diffusion_adapter_node" name="camp_diffusion_adapter" output="screen">
    <param from="$(var adapter_param_path)"/>
    <param from="$(var vehicle_info_param_path)"/>
    <param name="model.base_model_directory" value="$(var model_directory)"/>
    <param name="plugins_path" value="$(var plugins_path)"/>
    <param name="fixed_weight_model_path" value="$(var fixed_weight_model_path)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="~/input/odometry" to="$(var input_odometry)"/>
    <remap from="~/input/acceleration" to="$(var input_acceleration)"/>
    <remap from="~/input/route" to="$(var input_route)"/>
    <remap from="~/input/traffic_signals" to="$(var input_traffic_signals)"/>
    <remap from="~/input/tracked_objects" to="$(var input_tracked_objects)"/>
    <remap from="~/input/vector_map" to="$(var input_vector_map)"/>
    <remap from="~/input/turn_indicators" to="$(var input_turn_indicators)"/>
    <remap from="~/input/selection" to="$(var selection_topic)"/>
    <remap from="~/output/candidate_pool" to="$(var candidate_pool_topic)"/>
    <remap from="~/output/trajectories" to="$(var output_trajectories)"/>
    <remap from="~/output/trajectory" to="$(var output_trajectory)"/>
    <remap from="~/output/predicted_objects" to="$(var output_predicted_objects)"/>
    <remap from="~/output/turn_indicators" to="$(var output_turn_indicators)"/>
    <remap from="~/output/accepted_selection" to="$(var output_accepted_selection)"/>
  </node>

  <node pkg="autoware_camp_selector" exec="camp_selector_node" name="camp_selector" output="screen">
    <param name="fixed_weight_model_path" value="$(var fixed_weight_model_path)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="~/input/candidate_pool" to="$(var candidate_pool_topic)"/>
    <remap from="~/output/selection" to="$(var selection_topic)"/>
    <!-- Only the adapter's validated outputs are connected to the planner consumer. -->
    <remap from="~/output/trajectory" to="/debug/camp/selected_candidate/trajectory"/>
    <remap from="~/output/turn_indicators" to="/debug/camp/selected_candidate/turn_indicators"/>
  </node>
</launch>
